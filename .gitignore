# 1. 忽略根目录下的所有文件夹
/*/

# 2. 强制保留（不忽略）你指定的文件夹
!/config/
!/configs/
!/experiments/
!/scripts/
!/src/
!/third_party/
!/visualizations/
!/tests/
/tests/*
!/tests/test_latent_action_cache.py
!/tests/test_latent_action_decoder.py
!/tests/test_latent_action_pipeline.py

# 忽略所有日志文件
*.log

# 忽略环境配置缓存
.deepspeed_env
.wandb_key
.env
.env.*
!.env.example

# 忽略 Python 编译缓存
__pycache__/
*.pyc
*.pyo

# 忽略编辑器交换文件
*.swp
*.swo

# 忽略下载的数据集压缩包
*.tar.gz
*.tar.gz?download=true